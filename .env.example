# Copy to .env (git-ignored) and load it: `set -a; source .env; set +a`

# Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon public" key. Safe for browsers.
SUPABASE_ANON_KEY=

# ONLY for scripts/create-operators.mjs on your own machine. Never put this in GitHub
# secrets, the repo, or the website.
# SUPABASE_SERVICE_KEY=
